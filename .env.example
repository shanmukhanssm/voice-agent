# AI Voice Sales Bot - environment template (all six vars are OPTIONAL).
# Copy to .env and fill what you have; the app boots with zero keys
# (ADR H-01: malformed value -> boot abort naming the var; missing -> warn).
# Keys ship commented with no values so a straight copy stays a zero-keys boot.
# Malformed example: XKIRO_BASE_URL="not a url" -> boot aborts.

# Groq API key - ASR + LLM primary chains on the laptop path (absent -> chain starts at next provider)
# GROQ_API_KEY=

# Xkiro API key - hosted LLM failover chain (Task 17-a; user-provided; absent -> chain starts at next provider)
# XKIRO_API_KEY=

# Xkiro base URL for the LLM failover chain (default https://api.xkiro.com/v1; must parse as URL)
# XKIRO_BASE_URL=

# Shared secret for the server-to-server /internal/voice-config feed
# (main server :3000 <- voice-service :3003; NEVER sent by the browser;
# generate with: openssl rand -hex 32)
# INTERNAL_SETTINGS_TOKEN=

# Supabase project URL - deploy storage switch only (must parse as URL)
# SUPABASE_URL=

# Supabase service-role key - deploy storage client, server-only, never logged (empty string is malformed)
# SUPABASE_SERVICE_ROLE_KEY=

# Prisma datasource - SQLite file in sandbox (file:../db/custom.db, resolved
# relative to prisma/), Postgres string at deploy (must carry a scheme)
# DATABASE_URL=
